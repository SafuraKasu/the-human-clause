# Copy to .env (never commit .env)
# gemini | groq | openrouter | ollama | custom
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Only for provider=custom (any OpenAI-compatible endpoint)
LLM_BASE_URL=
# mock = scripted/cached LLM responses, live = real provider
LLM_MODE=mock
# Backup model used if the main one keeps failing
LLM_FALLBACK_MODEL=
# Where live responses are cached for offline replay (default data/llm_cache)
LLM_CACHE_DIR=
